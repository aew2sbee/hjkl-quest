---
import type { Lesson } from '../lessons/types';

interface Props {
  lesson: Lesson;
}

const { lesson } = Astro.props;
const no = lesson.id.replace('-', '.');
---

<aside class="quest" aria-label="クエスト">
  <div class="qtext">
    <h2>QUEST · {no}</h2>
    <h1>{lesson.heading}</h1>
    <div class="lead">
      {lesson.lead.map((sentence) => <p set:html={sentence} />)}
    </div>
  </div>
  <ul class="todos" aria-label="TODO">
    {
      lesson.todos.map((t, i) => (
        <li class:list={['todo', { now: i === 0 }]} data-todo={t.id}>
          <span class="box" aria-hidden="true" />
          <span class="t" set:html={t.text} />
        </li>
      ))
    }
  </ul>
  <div class="hint" id="hint" hidden></div>
  <div class="qactions">
    <button class="btn" id="btn-hint" type="button">💡 ヒント</button>
    <button class="btn" id="btn-reset" type="button">↺ やり直す</button>
  </div>
  <div class="clear" id="clear" hidden>
    <b>Lesson {no} クリア！</b>
    <span id="clear-sub"></span>
  </div>
</aside>

<style>
  .quest {
    background: var(--surface);
    border-radius: var(--r);
    padding: 16px 18px;
    display: grid;
    gap: 12px;
  }
  .qtext {
    display: grid;
    gap: 6px;
  }
  h2 {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  h1 {
    margin: 0;
    font-size: 21px;
    font-weight: 800;
    line-height: 1.35;
    text-wrap: balance;
  }
  .lead {
    display: grid;
    gap: 2px;
    color: var(--muted);
    line-height: 1.7;
    font-size: 14px;
  }
  .lead p {
    margin: 0;
  }
  .todos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .todo {
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 10px;
    align-items: center;
    padding: 7px 12px;
    border-radius: 14px;
    background: var(--surface-2);
    color: var(--muted);
    transition:
      background 0.3s,
      color 0.3s;
  }
  .box {
    width: 24px;
    height: 24px;
    border-radius: 8px;
    border: 2px solid var(--line);
    display: grid;
    place-items: center;
    font-size: 14px;
  }
  .todo.now {
    background: color-mix(in srgb, var(--vim) 18%, var(--surface-2));
    color: var(--fg);
    outline: 2px solid var(--vim);
  }
  .todo.now .box {
    border-color: var(--vim-glow);
  }
  .todo.done {
    color: var(--fg);
  }
  .todo.done .box {
    background: var(--vim);
    border-color: var(--vim);
    color: #fff;
    animation: check 0.45s cubic-bezier(0.3, 1.8, 0.5, 1);
  }
  .todo.done .box::after {
    content: '✓';
  }
  .todo.done .t {
    text-decoration: line-through;
    text-decoration-color: var(--vim);
    text-decoration-thickness: 2px;
    opacity: 0.75;
  }
  @keyframes check {
    from {
      transform: scale(0.2) rotate(-30deg);
    }
  }
  .quest :global(code) {
    font-family: var(--font-mono);
    background: var(--ed-bg);
    color: var(--vim-glow);
    padding: 1px 6px;
    border-radius: 6px;
    font-size: 0.92em;
  }
  /* Matches .cm-target in the editor, so "*" in the text reads as the glowing target. */
  .quest :global(code.star) {
    color: var(--star);
    font-weight: 700;
    text-shadow: 0 0 8px var(--star);
  }
  .hint {
    font-size: 13px;
    line-height: 1.7;
    background: var(--ed-bg);
    border-radius: 12px;
    padding: 10px 12px;
    color: var(--ed-fg);
  }
  .hint[hidden],
  .clear[hidden] {
    display: none;
  }
  .qactions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .btn {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 13px;
    border: 0;
    border-radius: 999px;
    padding: 8px 14px;
    cursor: pointer;
    background: var(--surface-2);
    color: var(--fg);
  }
  .btn:focus-visible {
    outline: 2px solid var(--vim-glow);
    outline-offset: 2px;
  }
  .clear {
    display: grid;
    gap: 6px;
    text-align: center;
    background: linear-gradient(160deg, color-mix(in srgb, var(--vim) 30%, var(--surface)), var(--surface));
    border-radius: var(--r);
    padding: 18px;
    animation: pop 0.5s ease-out;
  }
  .clear b {
    font-size: 19px;
  }
  @keyframes pop {
    from {
      transform: translateY(-6px) scale(1.05);
      opacity: 0.3;
    }
  }
</style>

---
interface Props {
  /** "1.1" */
  no: string;
  /** The next lesson in the chapter list, or undefined after the last one. */
  next?: { no: string; title: string; href: string; ready: boolean };
}

const { no, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const continueHref = next?.ready ? next.href : base;
---

<dialog class="clear-dialog" id="clear-dialog" aria-labelledby="clear-title">
  <div class="trophy" aria-hidden="true">🏆</div>
  <h2 id="clear-title">Lesson {no} クリア！</h2>
  <p class="keys" id="clear-keys"></p>
  <div class="next">
    {
      next?.ready && (
        <p>
          次は <b>{next.no} {next.title}</b> です。
        </p>
      )
    }
    {
      next && !next.ready && (
        <>
          <p>
            次の <b>{next.no} {next.title}</b> は準備中です。
          </p>
          <p>続けるとトップページに戻ります。</p>
        </>
      )
    }
    {
      !next && (
        <>
          <p>これで全部のレッスンをクリアしました。</p>
          <p>続けるとトップページに戻ります。</p>
        </>
      )
    }
  </div>
  <div class="actions">
    <button class="btn" id="clear-retry" type="button">↺ もう一度</button>
    <a class="btn primary" href={continueHref} autofocus>続ける →</a>
  </div>
</dialog>

<style>
  .clear-dialog {
    width: min(420px, calc(100% - 32px));
    border: 2px solid var(--vim);
    border-radius: var(--r);
    padding: 24px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--vim) 30%, var(--surface)), var(--surface));
    color: var(--fg);
    text-align: center;
    box-shadow: 0 12px 40px #000a;
  }
  .clear-dialog[open] {
    display: grid;
    gap: 10px;
    animation: pop 0.4s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .clear-dialog::backdrop {
    background: #000a;
  }
  .trophy {
    font-size: 40px;
  }
  h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 800;
  }
  p {
    margin: 0;
    line-height: 1.7;
  }
  .keys {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .next {
    font-size: 14px;
  }
  .actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin-top: 8px;
  }
  .btn {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 14px;
    border: 0;
    border-radius: 999px;
    padding: 10px 18px;
    cursor: pointer;
    background: var(--surface-2);
    color: var(--fg);
    text-decoration: none;
  }
  .btn.primary {
    background: var(--vim-deep);
    box-shadow: 0 4px 0 #06551f;
    color: #fff;
  }
  .btn:focus-visible {
    outline: 2px solid var(--vim-glow);
    outline-offset: 3px;
  }
  @keyframes pop {
    from {
      transform: scale(0.9);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .clear-dialog[open] {
      animation: none;
    }
  }
</style>

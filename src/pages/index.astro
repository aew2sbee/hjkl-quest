---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base>
  <section class="hero">
    <h1 class="tagline">TODOをクリアしながら、ブラウザで楽しくVimを覚えよう</h1>
    <p class="soon">いま遊べるのは最初のクエストだけです。ほかのクエストも順番に追加していきます。</p>
    <a class="start" href={`${base}lesson/1-1/`}>1.1 カーソルの移動からはじめる →</a>
  </section>
</Base>

<style>
  .hero {
    background: var(--surface);
    border-radius: var(--r);
    padding: 24px;
    display: grid;
    gap: 8px;
  }
  .tagline {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
  }
  .soon {
    margin: 0;
    color: var(--muted);
  }
  .start {
    justify-self: start;
    margin-top: 8px;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--vim-deep);
    box-shadow: 0 4px 0 #06551f;
    color: #fff;
    font-weight: 800;
    text-decoration: none;
  }
  .start:focus-visible {
    outline: 2px solid var(--vim-glow);
    outline-offset: 3px;
  }
</style>

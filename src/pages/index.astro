---
import Base from '../layouts/Base.astro';
import { chapters, lessons } from '../lessons';

const base = import.meta.env.BASE_URL;
const keys = [
  { key: 'h', label: '左' },
  { key: 'j', label: '下' },
  { key: 'k', label: '上' },
  { key: 'l', label: '右' },
];
---

<Base>
  <section class="hero">
    <div class="play">
      <div class="keys" role="group" aria-label="試せるキー">
        {
          keys.map((k) => (
            <button type="button" class="key" data-key={k.key} aria-label={`${k.key}（${k.label}）`}>
              <span class="cap">{k.key}</span>
              <span class="dir" aria-hidden="true">
                {k.label}
              </span>
            </button>
          ))
        }
      </div>
      <pre class="map" id="map" aria-hidden="true"></pre>
    </div>
    <h1>TODOをクリアしながら、ブラウザで楽しくVimを覚えよう</h1>
    <p class="try" id="try" aria-live="polite">h j k l のキー（上のボタンでも動きます）で、黄色い * までカーソルを動かしてみよう。</p>
    <a class="start" href={`${base}lesson/1-1/`}>1.1 カーソルの移動からはじめる</a>
  </section>

  <section class="chapters" aria-labelledby="chapters-title">
    <h2 id="chapters-title">7つの章</h2>
    <ol>
      {
        chapters.map((ch) => (
          <li>
            <span class="no">{String(ch.no).padStart(2, '0')}</span>
            <span class="title">{ch.title}</span>
            {ch.lessons.some((l) => l.id in lessons) ? (
              <span class="lessons">
                {ch.lessons.map((l) =>
                  l.id in lessons ? (
                    <a href={`${base}lesson/${l.id}/`}>
                      {l.id.replace('-', '.')} {l.title}
                    </a>
                  ) : null,
                )}
              </span>
            ) : (
              <span class="soon">準備中</span>
            )}
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  // A taste of lesson 1.1: h j k l move a cursor over a small map until it reaches the star.
  const W = 9;
  const H = 3;
  const map = document.getElementById('map')!;
  const tryLine = document.getElementById('try')!;
  const moves: Record<string, [number, number]> = { h: [0, -1], j: [1, 0], k: [-1, 0], l: [0, 1] };
  const stars: [number, number][] = [
    [1, 6],
    [2, 2],
    [0, 8],
    [2, 7],
    [0, 3],
  ];
  let cur: [number, number] = [0, 0];
  let starIdx = 0;
  let reached = 0;

  function render() {
    const [sr, sc] = stars[starIdx];
    const rows: string[] = [];
    for (let r = 0; r < H; r++) {
      let row = '';
      for (let c = 0; c < W; c++) {
        const ch = r === sr && c === sc ? '*' : '.';
        const cls = r === cur[0] && c === cur[1] ? 'cur' : ch === '*' ? 'star' : '';
        row += cls ? `<span class="${cls}">${ch}</span>` : ch;
      }
      rows.push(row);
    }
    map.innerHTML = rows.join('\n');
  }

  function press(key: string) {
    const btn = document.querySelector<HTMLElement>(`.key[data-key="${key}"]`);
    btn?.classList.add('down');
    window.setTimeout(() => btn?.classList.remove('down'), 120);
    const [dr, dc] = moves[key];
    cur = [Math.min(H - 1, Math.max(0, cur[0] + dr)), Math.min(W - 1, Math.max(0, cur[1] + dc))];
    const [sr, sc] = stars[starIdx];
    if (cur[0] === sr && cur[1] === sc) {
      reached++;
      starIdx = (starIdx + 1) % stars.length;
      tryLine.textContent =
        reached === 1
          ? 'できた！ 次の * も追いかけてみよう。'
          : `${reached} 個目！ この調子で、レッスン 1.1 で本物の Vim を動かそう。`;
    }
    render();
  }

  window.addEventListener('keydown', (e) => {
    if (e.ctrlKey || e.metaKey || e.altKey || e.isComposing || !(e.key in moves)) return;
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    e.preventDefault();
    press(e.key);
  });
  document.querySelectorAll<HTMLButtonElement>('.key').forEach((b) =>
    b.addEventListener('click', () => press(b.dataset.key!)),
  );
  render();
</script>

<style>
  .hero {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding: 32px 0 40px;
    max-width: 760px;
  }
  .play {
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 8px;
  }
  .keys {
    display: flex;
    gap: 12px;
  }
  .key {
    display: grid;
    justify-items: center;
    gap: 2px;
    width: 76px;
    padding: 10px 0 8px;
    border: 0;
    border-radius: 14px;
    background: var(--vim-deep);
    color: #fff;
    box-shadow: 0 8px 0 #06551f;
    cursor: pointer;
    transition:
      transform 0.08s,
      box-shadow 0.08s;
  }
  .key.down,
  .key:active {
    transform: translateY(6px);
    box-shadow: 0 2px 0 #06551f;
  }
  .key:focus-visible {
    outline: 3px solid var(--vim-glow);
    outline-offset: 4px;
  }
  .cap {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 44px;
    line-height: 1;
  }
  .dir {
    font-size: 12px;
    color: color-mix(in srgb, #fff 75%, transparent);
  }
  .map {
    margin: 0;
    padding: 12px 16px;
    border-radius: 10px;
    background: var(--ed-bg);
    color: var(--ed-dim);
    font-family: var(--font-mono);
    font-size: 20px;
    line-height: 1.5;
    letter-spacing: 0.3em;
  }
  .map :global(.star) {
    color: var(--star);
    text-shadow: 0 0 8px var(--star);
  }
  .map :global(.cur) {
    background: var(--ed-fg);
    color: var(--ed-bg);
    border-radius: 2px;
  }
  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 800;
    line-height: 1.4;
    text-wrap: balance;
  }
  .try {
    margin: 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.7;
  }
  .start {
    margin-top: 8px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--vim-deep);
    box-shadow: 0 4px 0 #06551f;
    color: #fff;
    font-weight: 800;
    font-size: 16px;
    text-decoration: none;
  }
  .start:focus-visible {
    outline: 2px solid var(--vim-glow);
    outline-offset: 3px;
  }

  .chapters {
    max-width: 760px;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .chapters h2 {
    margin: 0 0 12px;
    font-size: 20px;
    font-weight: 800;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  li {
    display: grid;
    grid-template-columns: 2em 9em 1fr;
    align-items: baseline;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    font-size: 16px;
  }
  .no {
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .title {
    font-weight: 700;
  }
  .lessons {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
  }
  .lessons a {
    color: var(--vim-glow);
    font-size: 14px;
  }
  .soon {
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 600px) {
    .key {
      width: 60px;
    }
    .cap {
      font-size: 34px;
    }
    li {
      grid-template-columns: 2em 1fr;
    }
    .lessons,
    .soon {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .key {
      transition: none;
    }
  }
</style>

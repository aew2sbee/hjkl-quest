---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="hero">
    <h1 class="tagline">TODOをクリアしながら、ブラウザで楽しくVimを覚えよう</h1>
    <p class="soon">現在準備中です。もうすぐ最初のクエストが遊べるようになります。</p>
  </section>
</Base>

<style>
  .hero {
    background: var(--surface);
    border-radius: 18px;
    padding: 24px;
    display: grid;
    gap: 8px;
  }
  .tagline {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
  }
  .soon {
    margin: 0;
    color: var(--muted);
  }
</style>

---
import { languages, langs } from '../i18n/ui';
import { isPreview, storagePrefix } from '../env';

const base = import.meta.env.BASE_URL;
const langKey = `${storagePrefix}lang`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <title>hjkl-quest</title>
    <script is:inline define:vars={{ base, langs, langKey }}>
      // Saved choice first, then the browser language, then English.
      let lang = null;
      try {
        lang = localStorage.getItem(langKey);
      } catch {}
      if (!langs.includes(lang)) {
        lang = (navigator.languages || [navigator.language])
          .map((l) => l.slice(0, 2).toLowerCase())
          .find((l) => langs.includes(l)) || 'en';
      }
      location.replace(base + lang + '/');
    </script>
  </head>
  <body style="background:#0e1712;color:#e8f3ec;font-family:sans-serif;padding:24px">
    <p>Choose a language / 言語を選択してください</p>
    <ul>
      {langs.map((l) => <li><a style="color:#7ee08f" href={`${base}${l}/`}>{languages[l]}</a></li>)}
    </ul>
  </body>
</html>

---
import ClearDialog from '../../components/ClearDialog.astro';
import QuestPanel from '../../components/QuestPanel.astro';
import Sidebar from '../../components/Sidebar.astro';
import Base from '../../layouts/Base.astro';
import { lessons, nextLesson } from '../../lessons';
import type { Lesson } from '../../lessons/types';

export function getStaticPaths() {
  return Object.values(lessons).map((lesson) => ({ params: { id: lesson.id }, props: { lesson } }));
}

const { lesson } = Astro.props as { lesson: Lesson };
const toNo = (id: string) => id.replace('-', '.');
const next = nextLesson(lesson.id);
---

<Base title={`${toNo(lesson.id)} ${lesson.title}`}>
  <div class="app" data-lesson={lesson.id}>
    <Sidebar current={lesson.id} />
    <div class="main">
      <QuestPanel lesson={lesson} />
      <section aria-label="エディタ">
        <div class="vimwin" data-screen={lesson.shell ? 'shell' : 'vim'}>
          <div class="titlebar" aria-hidden="true">
            <i></i><i></i><i></i><span class="title-vim">{lesson.fileName} — VIM</span><span class="title-shell"
              >~/quest — zsh</span
            >
          </div>
          <div id="shell"></div>
          <div id="editor"></div>
          <div class="status">
            <span class="mode" id="mode">NORMAL</span>
            <span class="file">{lesson.fileName}</span>
            <span class="pos" id="pos">{lesson.start.line + 1},{lesson.start.ch + 1}</span>
          </div>
          <div class="cmdline" id="cmdline" aria-live="polite"></div>
        </div>
        <div class="keylog" id="keylog" aria-hidden="true">
          <span>押したキー:</span><span class="empty">キーを押すと、ここに出ます</span>
        </div>
      </section>
    </div>
  </div>
  <div class="toast" id="toast" role="status" aria-live="polite">
    <span class="face" id="toast-face"></span>
    <span><span class="msg" id="toast-msg"></span><span class="sub" id="toast-sub"></span></span>
  </div>
  <ClearDialog
    no={toNo(lesson.id)}
    next={next && {
      no: toNo(next.id),
      title: next.title,
      href: `${import.meta.env.BASE_URL}lesson/${next.id}/`,
      ready: next.ready,
    }}
  />
</Base>

<script>
  import { createLessonEditor } from '../../engine/editor';
  import { advance, highlightFor, hjklFor, type KeyVerdict } from '../../engine/judge';
  import { createShell, parseShellCommand } from '../../engine/shell';
  import { lessons } from '../../lessons';
  import type { Snapshot } from '../../lessons/types';

  const $ = (id: string) => document.getElementById(id)!;
  const lesson = lessons[document.querySelector<HTMLElement>('[data-lesson]')!.dataset.lesson!];
  const win = document.querySelector<HTMLElement>('.vimwin')!;
  const todoEls = [...document.querySelectorAll<HTMLElement>('[data-todo]')];
  const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
  const keyLabels: Record<string, string> = {
    Escape: 'Esc',
    ' ': 'Space',
    ArrowLeft: '←',
    ArrowDown: '↓',
    ArrowUp: '↑',
    ArrowRight: '→',
  };

  const startScreen: Snapshot['screen'] = lesson.shell ? 'shell' : 'vim';
  let screen = startScreen;
  let ran: string[] = [];
  let done = 0;
  let keyCount = 0;
  // What :wq last wrote. Opening the file again shows this instead of the lesson's text.
  let saved: string[] | undefined;
  // Tell the learner only once per attempt that the text can no longer reach the goal.
  let stuckNoticed = false;
  // The highlight last sent to the editor, so it is only redrawn when it moves.
  let shownHighlight = '';

  // The command that opens the lesson file, as suggested at the prompt.
  const openCommand = lesson.saves ? `vim ${lesson.fileName}` : 'vim';
  const editor = createLessonEditor($('editor'), lesson, { onKey, onChange: judge, onQuit, onWriteQuit });
  const shell = createShell($('shell'), 'Welcome to hjkl-quest shell', openCommand, {
    onKey: (name) => onKey(name, 'pass'),
    onCommand,
  });

  function show(next: Snapshot['screen']) {
    screen = next;
    win.dataset.screen = next;
    focusScreen();
  }

  const focusScreen = () => (screen === 'vim' ? editor.focus() : shell.focus());

  function onCommand(input: string) {
    const cmd = parseShellCommand(input, lesson.fileName, lesson.saves);
    if (cmd.kind === 'vim') {
      ran = [...ran, 'vim'];
      resetEditor(saved);
      setCmdline('');
      show('vim');
      judge();
    } else if (cmd.kind === 'no-file') {
      shell.print(`このレッスンではファイル名まで付けて ${openCommand} で開こう`, 'tip');
    } else if (cmd.kind === 'other-file') {
      const ways = lesson.saves ? openCommand : `vim か vim ${lesson.fileName}`;
      shell.print(`このレッスンでは ${ways} で開こう`, 'tip');
    } else if (cmd.kind === 'unknown') {
      shell.print(`zsh: command not found: ${cmd.name}`, 'err');
      const tip = lesson.saves ? `${openCommand} と入力して` : 'v・i・m の3文字を入力して';
      shell.print(`💡 ${tip} Enter を押してね`, 'tip');
    }
  }

  function onQuit(force: boolean) {
    if (!lesson.shell) return;
    if (!force) {
      const msg = lesson.saves
        ? '保存して終了するときは :wq、変更を捨てて終了するときは :q! と打とう'
        : '変更を捨てて終了するときは :q! と ! まで付けよう';
      setCmdline(msg, 'err');
      return;
    }
    ran = [...ran, ':q!'];
    show('shell');
    judge();
  }

  function onWriteQuit() {
    if (!lesson.shell) return;
    if (!lesson.saves) {
      const savesId = Object.values(lessons).find((l) => l.saves)?.id.replace('-', '.');
      setCmdline(`保存は${savesId ? ` ${savesId} で` : 'あとで'}習うよ。今は :q! で終了しよう`, 'err');
      return;
    }
    saved = editor.snapshot().lines;
    // Vim reports the write like this as it quits.
    const bytes = new TextEncoder().encode(saved.join('\n') + '\n').length;
    shell.print(`"${lesson.fileName}" ${saved.length}L, ${bytes}B written`);
    ran = [...ran, ':wq'];
    show('shell');
    judge();
  }

  function onKey(name: string, verdict: Exclude<KeyVerdict, 'ignore'>) {
    const label = keyLabels[name] ?? name;
    logKey(label, verdict !== 'pass');
    if (verdict === 'pass') {
      keyCount++;
      setCmdline('');
    } else if (verdict === 'arrow') {
      toast('🙅', `矢印キーじゃなくて ${hjklFor(name)} で！`, 'hjkl なら手がホームポジションから離れないよ', true);
    } else {
      setCmdline(`"${label}" はまだ習っていないキーだよ。今は ${lesson.keys.join(' ')} を使おう`, 'err');
    }
  }

  function judge() {
    const s: Snapshot = { ...editor.snapshot(), screen, ran };
    const stuck = lesson.stuck?.(s) ?? false;
    // Until the learner starts over, keep pointing at the button that fixes it.
    $('btn-reset').classList.toggle('attention', stuck);
    if (stuck && !stuckNoticed) {
      stuckNoticed = true;
      toast('🤔', '必要な文字まで消えちゃった', '↺ やり直すで最初の文に戻せるよ', true);
    }
    $('pos').textContent = `${s.cursor.line + 1},${s.cursor.ch + 1}`;
    const mode = $('mode');
    mode.textContent = s.mode.toUpperCase();
    mode.dataset.mode = s.mode;

    const next = advance(lesson, done, s);
    const advanced = next > done;
    done = next;
    showHighlight(s.lines);
    if (!advanced) return;
    const finished = lesson.todos[done - 1];
    renderTodos();
    if (done < lesson.todos.length) {
      toast('🎉', pick(finished.praise), `TODO ${done}/${lesson.todos.length} 達成`);
    } else {
      setCmdline(`"${lesson.fileName}" quest complete!`, 'ok');
      $('clear-keys').textContent = `${pick(finished.praise)}  キー数 ${keyCount}（最短 ${lesson.optimalKeys}）`;
      // Let the last check mark land before the dialog covers the page.
      window.setTimeout(() => {
        $('toast').classList.remove('show');
        ($('clear-dialog') as HTMLDialogElement).showModal();
      }, 600);
    }
  }

  function renderTodos() {
    todoEls.forEach((el, i) => {
      el.classList.toggle('done', i < done);
      el.classList.toggle('now', i === done);
    });
  }

  // Edits move the marked word, so this runs after every change, not only when a TODO is done.
  function showHighlight(lines: string[]) {
    const span = highlightFor(lesson.todos[done], lines);
    const key = JSON.stringify(span);
    if (key === shownHighlight) return;
    shownHighlight = key;
    editor.setTarget(span);
  }

  function resetEditor(lines?: string[]) {
    editor.reset(lines);
    shownHighlight = '';
    stuckNoticed = false;
  }

  function setCmdline(text: string, kind?: 'err' | 'ok') {
    const el = $('cmdline');
    el.textContent = text;
    el.className = kind ? `cmdline ${kind}` : 'cmdline';
  }

  function logKey(label: string, bad: boolean) {
    const k = document.createElement('kbd');
    k.textContent = label;
    if (bad) k.className = 'bad';
    const log = $('keylog');
    log.append(k);
    const all = log.querySelectorAll('kbd');
    if (all.length > 12) all[0].remove();
  }

  let toastTimer: number | undefined;
  function toast(face: string, msg: string, sub = '', nudge = false) {
    $('toast-face').textContent = face;
    $('toast-msg').textContent = msg;
    $('toast-sub').textContent = sub;
    const t = $('toast');
    t.classList.toggle('nudge', nudge);
    t.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => t.classList.remove('show'), 2200);
  }

  $('btn-hint').addEventListener('click', () => {
    const hint = $('hint');
    hint.innerHTML = `💡 ${lesson.todos[Math.min(done, lesson.todos.length - 1)].hint}`;
    hint.hidden = false;
    focusScreen();
  });

  function restart() {
    done = 0;
    keyCount = 0;
    ran = [];
    saved = undefined;
    resetEditor();
    shell.reset();
    renderTodos();
    $('keylog').querySelectorAll('kbd').forEach((k) => k.remove());
    $('hint').hidden = true;
    setCmdline('');
    show(startScreen);
    judge();
  }

  $('btn-reset').addEventListener('click', restart);
  $('clear-retry').addEventListener('click', () => {
    ($('clear-dialog') as HTMLDialogElement).close();
    restart();
  });

  renderTodos();
  judge();
  focusScreen();
</script>

<style>
  .app {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 18px;
    align-items: start;
  }
  .main {
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  @media (max-width: 900px) {
    .app {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .vimwin {
    background: var(--ed-bg);
    border-radius: var(--r);
    overflow: hidden;
    border: 2px solid var(--line);
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .vimwin:focus-within {
    border-color: var(--vim);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--vim) 25%, transparent);
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 9px 14px;
    background: #121815;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ed-dim);
  }
  .titlebar i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #2a332e;
  }
  .titlebar span {
    margin-left: 8px;
  }

  /* One screen at a time: the shell prompt, or Vim with its status line. */
  .vimwin[data-screen='shell'] :is(#editor, .status, .cmdline, .title-vim),
  .vimwin[data-screen='vim'] :is(#shell, .title-shell) {
    display: none;
  }
  #shell {
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.7;
    padding: 8px 0 12px;
    min-height: 9em;
    color: var(--ed-fg);
    outline: none;
    cursor: text;
  }
  #shell :global(.sh) {
    padding: 0 14px;
    white-space: pre-wrap;
  }
  #shell :global(.p) {
    color: var(--vim-glow);
    font-weight: 700;
  }
  #shell :global(.ghost) {
    color: var(--ed-dim);
  }
  #shell :global(.err) {
    color: #ff6b6b;
  }
  #shell :global(.tip) {
    color: var(--star);
  }
  #shell :global(.caret) {
    display: inline-block;
    width: 0.6em;
    background: var(--ed-fg);
    animation: blink 1s steps(1) infinite;
  }
  #shell:not(:focus) :global(.caret) {
    background: transparent;
    outline: 1px solid var(--ed-fg);
    animation: none;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* CodeMirror builds its DOM at runtime, so these rules are global. */
  #editor :global(.cm-editor) {
    background: var(--ed-bg);
    color: var(--ed-fg);
    font-size: 15px;
    padding: 8px 0;
  }
  #editor :global(.cm-editor.cm-focused) {
    outline: none;
  }
  #editor :global(.cm-scroller) {
    font-family: var(--font-mono);
    line-height: 1.7;
  }
  #editor :global(.cm-gutters) {
    background: transparent;
    border: 0;
    color: var(--ed-dim);
  }
  #editor :global(.cm-lineNumbers .cm-gutterElement) {
    padding: 0 1em 0 1.2em;
  }
  #editor :global(.cm-editor .cm-fat-cursor) {
    background: var(--ed-fg);
    color: var(--ed-bg) !important;
  }
  #editor :global(.cm-editor:not(.cm-focused) .cm-fat-cursor) {
    background: none;
    outline: 1px solid var(--ed-fg);
  }
  /* The ":" command line Vim opens at the bottom of the editor. */
  #editor :global(.cm-panels) {
    background: var(--ed-bg);
    color: var(--ed-fg);
    border-top: 1px solid var(--line);
  }
  #editor :global(.cm-vim-panel) {
    font-family: var(--font-mono);
    font-size: 15px;
    padding: 4px 14px;
  }
  #editor :global(.cm-vim-panel input) {
    color: var(--ed-fg);
    font: inherit;
  }
  #editor :global(.cm-target) {
    color: var(--star);
    font-weight: 700;
    text-shadow: 0 0 8px var(--star);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 13px;
    background: #18201b;
    padding: 4px 14px 4px 0;
  }
  .mode {
    font-weight: 700;
    padding: 2px 12px;
    color: #08111d;
    background: var(--mode-normal);
  }
  .mode[data-mode='insert'] {
    background: var(--mode-insert);
  }
  .mode[data-mode='visual'] {
    background: var(--mode-visual);
  }
  .file {
    color: var(--ed-fg);
  }
  .pos {
    margin-left: auto;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .cmdline {
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 5px 14px 8px;
    min-height: 1.6em;
    color: var(--ed-fg);
  }
  .cmdline.err {
    color: #ff6b6b;
  }
  .cmdline.ok {
    color: var(--vim-glow);
  }

  .keylog {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
    min-height: 34px;
    color: var(--muted);
    font-size: 13px;
  }
  .keylog :global(kbd) {
    font-family: var(--font-mono);
    font-size: 14px;
    background: var(--surface-2);
    color: var(--fg);
    border-radius: 8px;
    padding: 3px 10px;
    box-shadow: 0 3px 0 var(--line);
    animation: pop 0.25s ease-out;
  }
  .keylog:has(:global(kbd)) .empty {
    display: none;
  }
  .empty {
    color: var(--ed-dim);
  }
  .keylog :global(kbd.bad) {
    background: color-mix(in srgb, var(--warn) 30%, var(--surface-2));
  }
  @keyframes pop {
    from {
      transform: translateY(-6px) scale(1.2);
      opacity: 0.3;
    }
  }

  .toast {
    position: fixed;
    left: 50%;
    bottom: 22px;
    transform: translate(-50%, 160%);
    display: flex;
    align-items: center;
    gap: 14px;
    background: var(--surface-2);
    border: 2px solid var(--vim);
    border-radius: 20px;
    padding: 12px 18px;
    box-shadow: 0 12px 40px #000a;
    transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
    max-width: calc(100% - 32px);
    z-index: 5;
  }
  .toast.show {
    transform: translate(-50%, 0);
  }
  .toast.nudge {
    border-color: var(--warn);
  }
  .face {
    font-size: 30px;
  }
  .msg {
    display: block;
    font-weight: 800;
    font-size: 16px;
  }
  .sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (prefers-reduced-motion: reduce) {
    .toast,
    .keylog :global(kbd) {
      transition: none;
      animation: none;
    }
  }
</style>

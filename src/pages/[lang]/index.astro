---
import Base from '../../layouts/Base.astro';
import { langs, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang}>
  <section class="hero">
    <p class="tagline">{t(lang, 'site.tagline')}</p>
    <p class="soon">{t(lang, 'home.comingSoon')}</p>
  </section>
</Base>

<style>
  .hero {
    background: var(--surface);
    border-radius: 18px;
    padding: 24px;
    display: grid;
    gap: 8px;
  }
  .tagline {
    margin: 0;
    font-size: 20px;
    font-weight: 800;
  }
  .soon {
    margin: 0;
    color: var(--muted);
  }
</style>

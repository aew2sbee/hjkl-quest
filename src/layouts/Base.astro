---
import { languages, langs, type Lang } from '../i18n/ui';
import { isPreview } from '../env';

interface Props {
  lang: Lang;
  title?: string;
}

const { lang, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const pageTitle = title ? `${title} | hjkl-quest` : 'hjkl-quest';
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    {langs.map((l) => <link rel="alternate" hreflang={l} href={`${base}${l}/`} />)}
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="header">
      <a class="logo" href={`${base}${lang}/`}>
        <span class="keys"><kbd>h</kbd><kbd>j</kbd><kbd>k</kbd><kbd>l</kbd></span><span class="q">-quest</span>
      </a>
      {isPreview && <span class="preview-badge" title={base}>PREVIEW</span>}
      <nav class="lang" aria-label="Language">
        {
          langs.map((l) => (
            <a href={`${base}${l}/`} aria-current={l === lang ? 'true' : undefined} data-lang={l}>
              {languages[l]}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <script>
      import { storagePrefix } from '../env';

      // Remember the language the user picked so the root page can redirect next time.
      document.querySelectorAll<HTMLAnchorElement>('.lang a').forEach((a) => {
        a.addEventListener('click', () => {
          try {
            localStorage.setItem(`${storagePrefix}lang`, a.dataset.lang ?? '');
          } catch {}
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #0e1712;
    --surface: #17251d;
    --surface-2: #203329;
    --line: #2c4436;
    --fg: #e8f3ec;
    --muted: #8fa89a;
    --vim: #2bb24c;
    --vim-deep: #019833;
    --vim-glow: #7ee08f;
    --font-ui: 'M PLUS Rounded 1c', 'Hiragino Maru Gothic ProN', 'Yu Gothic UI', sans-serif;
    --font-mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-ui);
  }
</style>

<style>
  .header {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    max-width: 1240px;
    margin: 0 auto;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 22px;
    color: var(--fg);
    text-decoration: none;
  }
  .keys {
    display: inline-flex;
    gap: 3px;
  }
  kbd {
    background: var(--vim-deep);
    color: #fff;
    border-radius: 7px;
    padding: 1px 7px;
    box-shadow: 0 3px 0 #06551f;
    font-family: var(--font-mono);
    font-size: 18px;
  }
  .q {
    color: var(--vim-glow);
  }
  .preview-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #1a1200;
    background: #ffd34d;
    border-radius: 6px;
    padding: 3px 8px;
  }
  .lang {
    margin-left: auto;
    display: inline-flex;
    background: var(--surface);
    border-radius: 999px;
    padding: 3px;
  }
  .lang a {
    padding: 5px 12px;
    border-radius: 999px;
    color: var(--muted);
    font-weight: 700;
    font-size: 13px;
    text-decoration: none;
  }
  .lang a[aria-current='true'] {
    background: var(--surface-2);
    color: var(--fg);
  }
  main {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 16px 48px;
  }
</style>
